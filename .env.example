# Neon PostgreSQL (obtén la connection string en https://neon.tech)
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/logistica_acopio?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/logistica_acopio?sslmode=require"

JWT_SECRET=genera_un_secreto_seguro_aqui

# URL pública para enlaces compartidos (QR, etc.)
# En local: http://localhost:3000
# En producción: https://tu-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

WHATSAPP_API_TOKEN=tu_token_api_whatsapp
WHATSAPP_PHONE_ID=tu_whatsapp_phone_id

# NATS.io (opcional - si no se configura, los eventos solo se loguean)
NATS_URL=nats://nats:4222

# Didit KYC (https://didit.me)
# Obtén estos valores ejecutando: npx tsx scripts/setup-didit.ts
# O manualmente en https://business.didit.me
DIDIT_API_KEY=tu_didit_api_key
DIDIT_WORKFLOW_ID=tu_workflow_id_uuid
DIDIT_WEBHOOK_SECRET=tu_webhook_secret

# Mock KYC (true = saltar verificación Didit, útil para desarrollo local)
# IS_KYC_MOCKED=true

# Email para el setup script (solo para scripts/setup-didit.ts)
# DIDIT_EMAIL=tu@email.com
# DIDIT_PASSWORD=tu_password_segura
